# --- База (docker compose из корня репо) ---
DATABASE_URL=postgresql://justina:justina@localhost:5433/justina

# --- Claude: нужен для /ask (агент) и contextual retrieval ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# --- Эмбеддинги ---
# Лёгкая (сейчас):  intfloat/multilingual-e5-small, 384
# Лучше (2.3 ГБ):   BAAI/bge-m3, 1024
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
EMBEDDING_BATCH=32

# --- Reranker bge-reranker-v2-m3 (2.3 ГБ), true когда модель скачана ---
RERANK_ENABLED=false

# --- HuggingFace: токен ускоряет скачивание моделей (необязательно) ---
HF_TOKEN=
