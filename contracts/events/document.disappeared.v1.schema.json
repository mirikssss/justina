{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "document.disappeared.v1.schema.json",
  "title": "document.disappeared",
  "description": "Запись пропала из двух полных снимков подряд",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "document.disappeared"
    },
    "schema": {
      "const": "document.disappeared/v1"
    },
    "producer": {
      "const": "documents"
    },
    "data": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "document_id",
        "last_version_no",
        "missing_count"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "format": "uuid"
        },
        "last_version_no": {
          "type": "integer"
        },
        "missing_count": {
          "type": "integer",
          "minimum": 2
        }
      }
    }
  }
}
