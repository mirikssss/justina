# Скопируйте в .env (он в .gitignore). Секреты — только здесь, никогда в git.
ENV=dev
DATABASE_URL=postgresql://storozh:storozh@localhost:5433/storozh

# --- Безопасность (shared/crypto): python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
MASTER_KEY=
PINFL_HMAC_KEY=
INGEST_HMAC_KEY=
CALLBACK_HMAC_KEY=

# --- Telegram (guard/bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
PUBLIC_WEB_URL=http://localhost:3000

# --- Помощник: Claude и эмбеддинги
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Лёгкая: intfloat/multilingual-e5-small, 384 · Лучше (2.3 ГБ): BAAI/bge-m3, 1024
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
EMBEDDING_BATCH=32
RERANK_ENABLED=false
HF_TOKEN=

# --- Веб
NEXT_PUBLIC_API_URL=http://localhost:8000
